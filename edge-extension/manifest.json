{
  "manifest_version": 3,
  "name": "Boss Radar · Grupo de checagens",
  "version": "1.3.0",
  "description": "Importa checagens do grupo escolhido para o Boss Radar em uma origem local ou HTTPS autorizada.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://127.0.0.1:4317/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Boss Radar: checagens do grupo"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
